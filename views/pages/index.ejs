<%- include('../layout', { body: `
<div class="container-fluid py-4">
  <div class="row align-items-start">

    <!-- Левая колонка (иллюстрация / картинка) -->
    <div class="col-12 col-md-4 mb-4 mb-md-0">
      <img src="/images/pig3.png" alt="Pig Dice Rules" class="img-fluid rounded mb-3" style="max-width: 250px;">
      <h2 class="legend-title fw-bold fst-italic">How to Play</h2>
      <p class="legend-text">
        A simple yet addictive dice game of luck and courage.  
        Every roll could bring victory — or reset your score!
      </p>
    </div>

    <!-- Правая колонка (текст с правилами) -->
    <div class="col-12 col-md-8">
      <h2 class="legend-title mt-3">🎲 Pig Dice Game Rules 🐷</h2>

      <p class="legend-text">
        The Pig Dice game is played with two dice.  
        Players take turns rolling both dice as many times as they wish, adding up their total points for the turn.
      </p>

      <p class="legend-text">
        The goal is to reach <strong>100 points</strong>.  
        But beware — if you roll a single <strong>1</strong> on either die, you lose all points accumulated during that turn and your turn ends immediately!
